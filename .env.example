# Copy to .env for local runs. In CI these are GitHub Actions Secrets (Section 13) —
# never commit a real .env; it's already in .gitignore.

# --- Database (Supabase free Postgres) ---
# Supabase dashboard → Project Settings → Database → Connection string (URI, "Session" mode)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Telegram ---
# Create a bot via @BotFather → /newbot, copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# Channel chat ids (Crypto Notebook, Crypto Wall Street, etc.) are NOT env vars —
# they're literal `chat_id` values in config/channel_config.yaml, pushed to the DB
# by scripts/seed_config.py. Add the bot as admin of each channel, post anything
# in it, then hit https://api.telegram.org/bot<token>/getUpdates to read its chat
# id (looks like -100xxxxxxxxxx).

# Comma-separated Telegram user IDs allowed to approve/reject/edit via the bot
# (Section 13 — every incoming update is checked against this allow-list before
# anything happens). Get your own numeric id from @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# Chat id notifications/alerts/approval prompts get sent TO (Section 9) — this is
# YOUR private chat with the bot (DM it first so it can message you), NOT any
# public channel's chat id. Also get this from @userinfobot or the getUpdates
# trick above after DMing your bot.
TELEGRAM_OPERATOR_CHAT_ID=

# --- LLM providers ---
# DeepSeek is the default triage + write model (platform.deepseek.com → API keys).
DEEPSEEK_API_KEY=

# Optional: Gemini 2.5 Flash-Lite as a free-tier alternative triage model
# (aistudio.google.com/apikey).
GEMINI_API_KEY=

# --- Data sources (DeFi yields uses none of these — DefiLlama's yields API is
# free and keyless.) ---
CRYPTOPANIC_API_KEY=   # not yet used — Phase 2's news category

# Required for whale_movements (Phase 2, live since 2026-09-10). Free tier:
# etherscan.io/apis -> sign up -> create an API key. 3 calls/sec, 100k/day —
# this collector uses well under 100/day at the current watchlist size.
ETHERSCAN_API_KEY=

# LLM cost guard (pipeline/llm_usage.py) -- all optional, defaults shown. Alerts go to
# the operator on Telegram at most once per UTC day per kind.
# Near-real-time (re-alert every LLM_REALERT_MINUTES while the condition persists):
# LLM_RATE_WINDOW_MINUTES=15       # rolling window for the call-rate guard
# LLM_RATE_ALERT_CALLS=20          # alert at this many calls in that window
# LLM_REPEAT_WINDOW_MINUTES=30     # window for the identical-prompt guard
# LLM_REPEAT_ALERT_COUNT=5         # alert when one prompt is sent this many times in it
# LLM_REALERT_MINUTES=60           # re-alert cadence while still happening
# Daily backstops (once per UTC day):
# LLM_DAILY_SPEND_ALERT_USD=0.10   # estimated spend today
# LLM_DAILY_CALLS_ALERT=150        # LLM calls today (counts failed calls too)
# LLM_BALANCE_ALERT_USD=0.50       # DeepSeek balance floor
